<% content_for :container_class, "max-w-4xl" %>
<% content_for :head do %>
  <%# Self-contained UMD build: single file, no module graph to 404 %>
  <script src="<%= asset_path("chart.umd.js") %>" defer></script>
<% end %>
<div class="w-full" data-controller="studio">
  <div class="flex items-baseline justify-between">
    <h1 class="text-xl font-bold tracking-tight">Data studio</h1>
    <span class="text-xs text-zinc-500 dark:text-zinc-400">generalized voice UI renderer · Chart.js</span>
  </div>
  <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-300" data-studio-target="headline">
    Paste any dataset, then speak or type how to render it.
  </p>

  <!-- Dataset -->
  <div class="mt-3 rounded-2xl border border-black/5 bg-white px-4 py-3 shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="font-medium">Dataset (JSON array, or CSV with a header row)</span>
      <button data-action="click->studio#useSample" data-sample="bookstore" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">📚 Bookstore sales</button>
      <button data-action="click->studio#useSample" data-sample="workouts" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">🏃 Workouts</button>
      <button data-action="click->studio#useSample" data-sample="incidents" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">🚨 Incidents</button>
    </div>
    <textarea data-studio-target="dataset" rows="6" spellcheck="false"
              data-action="input->studio#datasetInput"
              placeholder='[{"genre":"fiction","units":42}, …] or CSV: genre,units&#10;fiction,42 — or pick a sample above'
              class="mt-2 max-h-64 w-full resize-y overflow-y-auto rounded-xl border border-zinc-200 bg-transparent px-3 py-2 font-mono text-base focus:outline-none dark:border-zinc-800"></textarea>
    <p class="mt-1 font-mono text-[11px] text-zinc-500 dark:text-zinc-400" data-studio-target="schemaLine">No dataset yet.</p>
  </div>

  <!-- Prompt bar -->
  <div class="mt-2 rounded-2xl border border-black/5 bg-white px-4 py-3 shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <div class="flex items-end gap-2">
      <textarea data-studio-target="prompt" rows="2" spellcheck="false"
             placeholder='"Bar chart of revenue by genre" — or tap 🎙 and say it'
             data-action="keydown->studio#promptKeydown input->studio#promptInput"
             class="max-h-64 min-w-0 flex-1 resize-y overflow-y-auto rounded-xl border border-zinc-200 bg-transparent px-3 py-2 text-base focus:outline-none dark:border-zinc-800"></textarea>
      <button data-studio-target="micButton" data-action="click->studio#toggleVoice" aria-label="Dictate your request"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-zinc-950 text-white transition-transform hover:scale-105 active:scale-95 dark:bg-zinc-50 dark:text-zinc-950">
        <span aria-hidden="true">🎙</span>
      </button>
      <button data-studio-target="askButton" data-action="click->studio#ask"
              class="shrink-0 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-500">Ask</button>
    </div>
    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-zinc-500 dark:text-zinc-400" data-studio-target="voiceStatus">Mic: tap 🎙 and speak (Chrome/Edge), or type.</span>
      <span data-studio-target="supportWarning" class="hidden rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-amber-700 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-300">No speech recognition here — type instead.</span>
    </div>
    <div class="mt-2 flex flex-wrap gap-2 text-xs">
      <button data-action="click->studio#usePrompt" data-prompt="Bar chart of revenue by genre" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">📊 Bars by genre</button>
      <button data-action="click->studio#usePrompt" data-prompt="Show the trend of units over month as a line" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">📈 Trend line</button>
      <button data-action="click->studio#usePrompt" data-prompt="Table of all incidents, biggest minutes_open first" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">🗂 Table</button>
      <button data-action="click->studio#usePrompt" data-prompt="KPI totals: how many workouts and total minutes" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">🔢 KPIs</button>
      <button data-action="click->studio#usePrompt" data-prompt="Bar chart of revenue by genre with KPI totals" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">🧩 Chart + KPIs</button>
    </div>
    <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400">Can render: table · cards · KPI · bar · line · pie · scatter · bubbles — name one in your request.</p>
  </div>

  <!-- Request -> UI latency line -->
  <div class="mt-2 flex items-baseline justify-between text-sm">
    <p class="text-zinc-500 dark:text-zinc-400">Request → UI
      <span data-studio-target="latency" class="text-2xl font-bold text-emerald-700 dark:text-emerald-400">—</span>
    </p>
    <p class="text-xs text-zinc-500 dark:text-zinc-400" data-studio-target="questionCount"></p>
  </div>
  <p class="text-xs text-zinc-500 dark:text-zinc-400" data-studio-target="status" aria-live="polite"></p>

  <!-- Rendered interface -->
  <div data-studio-target="canvas"
       class="mt-2 min-h-64 rounded-2xl border border-black/5 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <p class="text-sm text-zinc-400">Load a dataset and ask — e.g. pick 📚 Bookstore, then “Bar chart of revenue by genre”.</p>
  </div>

  <!-- Answer inspector -->
  <details class="mt-2 rounded-2xl border border-black/5 bg-white/60 px-4 py-2 text-xs text-zinc-600 dark:border-white/10 dark:bg-zinc-900/60 dark:text-zinc-300">
    <summary class="cursor-pointer py-1 font-medium">How this was built — schema-driven questions</summary>
    <p class="mt-1 leading-relaxed">
      The server infers your dataset's schema (column names + numeric/temporal/categorical/text types)
      and generates the question set from it: field-binding <code>choice</code> options are your actual
      columns, plus one <code>include_*</code> flag per column. Jev answers them all in parallel and this
      generic interpreter maps the winning spec onto Chart.js or table/cards/KPI DOM. Low-confidence
      answers (&lt; 0.5) fall back to the offline parse, marked below.
    </p>
    <div data-studio-target="inspector" class="mt-2 space-y-1 font-mono"></div>
  </details>

  <!-- API key (shared) -->
  <div class="mb-3 mt-3 rounded-2xl border border-black/5 bg-white px-5 py-4 shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <h2 class="text-[11px] font-medium tracking-[0.2em] text-zinc-400 dark:text-zinc-500">JEV API KEY</h2>
    <div class="mt-2 flex flex-col gap-2 sm:flex-row">
      <input data-studio-target="apiKey" type="password" placeholder="ts_..." autocomplete="off" spellcheck="false"
             class="w-full rounded-xl border border-zinc-200 bg-transparent px-3 py-2 font-mono text-base placeholder:text-zinc-400 focus:outline-none dark:border-zinc-800 dark:placeholder:text-zinc-600 sm:w-auto sm:flex-1" />
      <div class="flex gap-2">
        <button data-action="click->studio#toggleKeyVisibility"
                class="flex-1 rounded-full border border-zinc-300 px-3 py-2 text-xs text-zinc-600 sm:flex-none dark:border-zinc-700 dark:text-zinc-300">Show</button>
        <button data-action="click->studio#testKey" data-studio-target="testButton"
                class="flex-1 rounded-full bg-zinc-950 px-4 py-2 text-xs font-semibold text-white sm:flex-none dark:bg-zinc-50 dark:text-zinc-950">Test</button>
      </div>
    </div>
    <p data-studio-target="keyStatus" class="mt-1 text-xs text-zinc-500 dark:text-zinc-400"></p>
  </div>
</div>
