<div class="w-full" data-controller="speech-insights">
  <!-- Recorder -->
  <div data-speech-insights-target="recorderCard"
       class="rounded-2xl border border-black/5 bg-white px-5 py-6 text-center shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <p data-speech-insights-target="timer" class="text-4xl font-semibold tabular-nums tracking-tight">00:00</p>
    <div data-speech-insights-target="waveform" class="my-3 flex h-6 items-center justify-center gap-[3px]" aria-hidden="true"></div>
    <button data-speech-insights-target="recordButton" data-action="click->speech-insights#toggleListening"
            aria-label="Start speaking"
            class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-zinc-950 text-white transition-transform hover:scale-105 active:scale-95 dark:bg-zinc-50 dark:text-zinc-950">
      <svg data-speech-insights-target="iconMic" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="2" width="6" height="12" rx="3" />
        <path d="M5 10a7 7 0 0 0 14 0" />
        <line x1="12" y1="17" x2="12" y2="22" />
      </svg>
      <svg data-speech-insights-target="iconStop" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <rect x="6" y="6" width="12" height="12" rx="2" />
      </svg>
    </button>
    <p data-speech-insights-target="caption" class="mt-2 text-xs text-zinc-500 dark:text-zinc-400">Tap to speak</p>
    <div data-speech-insights-target="miniTranscript" aria-live="polite" class="mt-1 h-24 overflow-y-auto text-left text-sm leading-6"><span data-speech-insights-target="miniFinal"></span><span data-speech-insights-target="miniInterim" class="text-zinc-400 dark:text-zinc-500"></span><span data-speech-insights-target="miniState" class="ml-1"></span></div>
    <button data-action="click->speech-insights#clearTranscript"
            class="mt-2 rounded-full border border-zinc-300 px-4 py-1.5 text-xs text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">Clear</button>
    <p data-speech-insights-target="supportWarning" class="hidden rounded-xl border border-amber-200 bg-amber-50 p-2 text-xs text-amber-700 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-300">
      Your browser doesn't support the free built-in transcription (Web Speech API). Use Chrome or Edge on desktop/Android, or type in the box below.
    </p>
  </div>

  <!-- Metrics -->
  <div data-speech-insights-target="metricsGrid" class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
    <div data-speech-insights-target="cardEmotion" data-metric-card="emotion" class="rounded-2xl border border-black/5 border-t-4 border-t-rose-400 bg-white p-4 shadow-sm dark:border-white/10 dark:border-t-rose-500 dark:bg-zinc-900">
      <div class="flex items-center justify-between">
        <h3 class="flex items-center gap-2 text-sm font-medium"><span data-result="emoji" class="flex h-6 w-6 items-center justify-center rounded-full bg-rose-100 text-sm dark:bg-rose-950">😐</span>Emotion</h3>
        <label class="inline-flex cursor-pointer items-center">
          <input type="checkbox" value="emotion" checked data-speech-insights-target="metric" data-action="change->speech-insights#metricsChanged" class="peer sr-only" />
          <span class="relative h-5 w-9 rounded-full bg-zinc-300 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-transform peer-checked:bg-rose-500 peer-checked:after:translate-x-4 dark:bg-zinc-700 dark:peer-checked:bg-rose-500 dark:after:bg-zinc-950"></span>
        </label>
      </div>
      <p data-result="value" class="mt-1 text-3xl font-semibold capitalize text-zinc-300 dark:text-zinc-700">—</p>
      <div data-result="dist" class="mt-1 space-y-1 text-xs text-zinc-500 dark:text-zinc-400"></div>
      <p data-result="meta" class="mt-1 text-[11px] text-zinc-400 dark:text-zinc-500"></p>
    </div>
    <div data-speech-insights-target="cardHabits" data-metric-card="habits" class="rounded-2xl border border-black/5 border-t-4 border-t-amber-400 bg-white p-4 shadow-sm dark:border-white/10 dark:border-t-amber-500 dark:bg-zinc-900">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-medium">Speech habits</h3>
        <label class="inline-flex cursor-pointer items-center">
          <input type="checkbox" value="habits" checked data-speech-insights-target="metric" data-action="change->speech-insights#metricsChanged" class="peer sr-only" />
          <span class="relative h-5 w-9 rounded-full bg-zinc-300 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-transform peer-checked:bg-amber-500 peer-checked:after:translate-x-4 dark:bg-zinc-700 dark:peer-checked:bg-amber-500 dark:after:bg-zinc-950"></span>
        </label>
      </div>
      <p data-result="value" class="mt-1 text-3xl font-semibold tabular-nums text-zinc-300 dark:text-zinc-700">—</p>
      <div data-result="flags" class="mt-1 space-y-1 text-xs text-zinc-500 dark:text-zinc-400"></div>
      <p data-result="meta" class="mt-1 text-[11px] text-zinc-400 dark:text-zinc-500"></p>
      <p class="mt-1 text-[11px] text-zinc-400 dark:text-zinc-600">Yes / no · filler · hedging · repetition · questions</p>
    </div>
    <div data-speech-insights-target="cardGrammar" data-metric-card="grammar" class="rounded-2xl border border-black/5 border-t-4 border-t-emerald-400 bg-white p-4 shadow-sm dark:border-white/10 dark:border-t-emerald-500 dark:bg-zinc-900">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-medium">Grammar</h3>
        <label class="inline-flex cursor-pointer items-center">
          <input type="checkbox" value="grammar" checked data-speech-insights-target="metric" data-action="change->speech-insights#metricsChanged" class="peer sr-only" />
          <span class="relative h-5 w-9 rounded-full bg-zinc-300 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-transform peer-checked:bg-emerald-500 peer-checked:after:translate-x-4 dark:bg-zinc-700 dark:peer-checked:bg-emerald-500 dark:after:bg-zinc-950"></span>
        </label>
      </div>
      <p data-result="value" class="mt-1 text-3xl font-semibold tabular-nums text-zinc-300 dark:text-zinc-700">—</p>
      <p data-result="label" class="text-xs text-zinc-500 dark:text-zinc-400"></p>
      <div class="mt-2 h-1.5 rounded-full bg-zinc-200 dark:bg-zinc-800"><div data-result="bar" class="h-1.5 rounded-full bg-emerald-500" style="width:0%"></div></div>
      <p data-result="meta" class="mt-1 text-[11px] text-zinc-400 dark:text-zinc-500"></p>
      <p class="mt-1 text-[11px] text-zinc-400 dark:text-zinc-600">Score 0–3 · errors → fully correct · ignores likely mic-transcription slips</p>
    </div>
    <div data-speech-insights-target="cardComplexity" data-metric-card="complexity" class="rounded-2xl border border-black/5 border-t-4 border-t-violet-400 bg-white p-4 shadow-sm dark:border-white/10 dark:border-t-violet-500 dark:bg-zinc-900">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-medium">Complexity</h3>
        <label class="inline-flex cursor-pointer items-center">
          <input type="checkbox" value="complexity" checked data-speech-insights-target="metric" data-action="change->speech-insights#metricsChanged" class="peer sr-only" />
          <span class="relative h-5 w-9 rounded-full bg-zinc-300 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-transform peer-checked:bg-violet-500 peer-checked:after:translate-x-4 dark:bg-zinc-700 dark:peer-checked:bg-violet-500 dark:after:bg-zinc-950"></span>
        </label>
      </div>
      <p data-result="value" class="mt-1 text-3xl font-semibold tabular-nums text-zinc-300 dark:text-zinc-700">—</p>
      <p data-result="label" class="text-xs text-zinc-500 dark:text-zinc-400"></p>
      <div class="mt-2 h-1.5 rounded-full bg-zinc-200 dark:bg-zinc-800"><div data-result="bar" class="h-1.5 rounded-full bg-violet-500" style="width:0%"></div></div>
      <p data-result="meta" class="mt-1 text-[11px] text-zinc-400 dark:text-zinc-500"></p>
      <p class="mt-1 text-[11px] text-zinc-400 dark:text-zinc-600">Score 0–4 · simple → academic</p>
    </div>
    <div data-speech-insights-target="cardSpecificity" data-metric-card="specificity" class="rounded-2xl border border-black/5 border-t-4 border-t-sky-400 bg-white p-4 shadow-sm dark:border-white/10 dark:border-t-sky-500 dark:bg-zinc-900">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-medium">Specificity</h3>
        <label class="inline-flex cursor-pointer items-center">
          <input type="checkbox" value="specificity" checked data-speech-insights-target="metric" data-action="change->speech-insights#metricsChanged" class="peer sr-only" />
          <span class="relative h-5 w-9 rounded-full bg-zinc-300 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-transform peer-checked:bg-sky-500 peer-checked:after:translate-x-4 dark:bg-zinc-700 dark:peer-checked:bg-sky-500 dark:after:bg-zinc-950"></span>
        </label>
      </div>
      <p data-result="value" class="mt-1 text-3xl font-semibold tabular-nums text-zinc-300 dark:text-zinc-700">—</p>
      <p data-result="label" class="text-xs text-zinc-500 dark:text-zinc-400"></p>
      <div class="mt-2 h-1.5 rounded-full bg-zinc-200 dark:bg-zinc-800"><div data-result="bar" class="h-1.5 rounded-full bg-sky-500" style="width:0%"></div></div>
      <p data-result="meta" class="mt-1 text-[11px] text-zinc-400 dark:text-zinc-500"></p>
      <p class="mt-1 text-[11px] text-zinc-400 dark:text-zinc-600">Score 0–4 · vague → concrete details</p>
    </div>
    <div data-speech-insights-target="cardFactualClaim" data-metric-card="factual_claim" class="rounded-2xl border border-black/5 border-t-4 border-t-orange-400 bg-white p-4 shadow-sm dark:border-white/10 dark:border-t-orange-500 dark:bg-zinc-900">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-medium">Factual claim</h3>
        <label class="inline-flex cursor-pointer items-center">
          <input type="checkbox" value="factual_claim" checked data-speech-insights-target="metric" data-action="change->speech-insights#metricsChanged" class="peer sr-only" />
          <span class="relative h-5 w-9 rounded-full bg-zinc-300 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-transform peer-checked:bg-orange-500 peer-checked:after:translate-x-4 dark:bg-zinc-700 dark:peer-checked:bg-orange-500 dark:after:bg-zinc-950"></span>
        </label>
      </div>
      <p data-result="value" class="mt-1 text-3xl font-semibold tabular-nums text-zinc-300 dark:text-zinc-700">—</p>
      <p data-result="label" class="text-xs text-zinc-500 dark:text-zinc-400"></p>
      <div class="mt-2 h-1.5 rounded-full bg-zinc-200 dark:bg-zinc-800"><div data-result="bar" class="h-1.5 rounded-full bg-orange-500" style="width:0%"></div></div>
      <p data-result="meta" class="mt-1 text-[11px] text-zinc-400 dark:text-zinc-500"></p>
      <p class="mt-1 text-[11px] text-zinc-400 dark:text-zinc-600">Yes / no · states a checkable fact</p>
    </div>
  </div>

  <!-- Transcript -->
  <div data-speech-insights-target="transcriptCard"
       class="mt-3 rounded-2xl border border-black/5 bg-white px-5 py-4 shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <div class="flex items-baseline justify-between">
      <h2 class="text-[11px] font-medium tracking-[0.2em] text-zinc-400 dark:text-zinc-500">FULL TRANSCRIPT AND SETTINGS</h2>
      <span data-speech-insights-target="wordCount" class="text-xs text-zinc-400 dark:text-zinc-500"></span>
    </div>
    <div class="mt-2 min-h-12 text-sm leading-relaxed">
      <span data-speech-insights-target="transcriptFinal"></span><span data-speech-insights-target="transcriptInterim" class="text-zinc-400 dark:text-zinc-500"></span>
    </div>
    <textarea data-speech-insights-target="manualText" rows="5" placeholder="Or type / paste text to analyze instead…"
              data-action="input->speech-insights#fitManualText"
              class="mt-2 max-h-64 w-full resize-none overflow-y-auto rounded-xl border border-zinc-200 bg-transparent px-3 py-2 text-base placeholder:text-zinc-400 focus:outline-none dark:border-zinc-800 dark:placeholder:text-zinc-600"></textarea>
    <div class="mt-2 flex flex-col gap-2 text-xs text-zinc-500 dark:text-zinc-400">
      <label class="flex items-center gap-3">
        <span class="shrink-0">Every</span>
        <input data-speech-insights-target="wordInterval" type="range" min="1" max="30" step="1" value="5"
               data-action="input->speech-insights#cadenceChanged"
               class="h-1 min-w-0 flex-1 cursor-pointer accent-zinc-900 dark:accent-zinc-100" />
        <span data-speech-insights-target="wordIntervalLabel" class="shrink-0 whitespace-nowrap">5 words</span>
      </label>
      <label class="flex items-center gap-2">
        <input data-speech-insights-target="sentenceTrigger" type="checkbox" checked
               data-action="change->speech-insights#cadenceChanged"
               class="h-4 w-4 accent-zinc-900 dark:accent-zinc-100" />
        Every sentence
      </label>
      <label class="flex items-center gap-3">
        <span class="shrink-0">Window</span>
        <input data-speech-insights-target="charsWindow" type="range" min="100" max="1400" step="50" value="350"
               data-action="input->speech-insights#cadenceChanged"
               class="h-1 min-w-0 flex-1 cursor-pointer accent-zinc-900 dark:accent-zinc-100" />
        <span data-speech-insights-target="charsWindowLabel" class="shrink-0 whitespace-nowrap">350 chars (~58 words)</span>
      </label>
    </div>
    <div class="mt-2 flex gap-2">
      <button data-action="click->speech-insights#analyzeNow"
              class="rounded-full bg-zinc-950 px-4 py-1.5 text-xs font-semibold text-white dark:bg-zinc-50 dark:text-zinc-950">Analyze now</button>
      <button data-action="click->speech-insights#useSample"
              class="rounded-full border border-zinc-300 px-4 py-1.5 text-xs text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">Sample</button>
      <button data-action="click->speech-insights#clearTranscript"
              class="rounded-full border border-zinc-300 px-4 py-1.5 text-xs text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">Clear</button>
    </div>
  </div>

  <!-- API key -->
  <div data-speech-insights-target="apiKeyCard"
       class="mb-3 mt-3 rounded-2xl border border-black/5 bg-white px-5 py-4 shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <h2 class="text-[11px] font-medium tracking-[0.2em] text-zinc-400 dark:text-zinc-500">JEV API KEY</h2>
    <div class="mt-2 flex flex-col gap-2 sm:flex-row">
      <input data-speech-insights-target="apiKey" type="password" placeholder="ts_..." autocomplete="off" spellcheck="false"
             class="w-full rounded-xl border border-zinc-200 bg-transparent px-3 py-2 font-mono text-base placeholder:text-zinc-400 focus:outline-none dark:border-zinc-800 dark:placeholder:text-zinc-600 sm:w-auto sm:flex-1" />
      <div class="flex gap-2">
        <button data-action="click->speech-insights#toggleKeyVisibility"
                class="flex-1 rounded-full border border-zinc-300 px-3 py-2 text-xs text-zinc-600 sm:flex-none dark:border-zinc-700 dark:text-zinc-300">Show</button>
        <button data-action="click->speech-insights#testKey" data-speech-insights-target="testButton"
                class="flex-1 rounded-full bg-zinc-950 px-4 py-2 text-xs font-semibold text-white sm:flex-none dark:bg-zinc-50 dark:text-zinc-950">Test</button>
      </div>
    </div>
    <p class="mt-2 text-[11px] leading-relaxed text-zinc-500 dark:text-zinc-400">
      Stored only in <code>localStorage</code> on this device. Get a key at
      <a href="https://console.typesafe.ai/keys" target="_blank" rel="noopener" class="underline">console.typesafe.ai/keys</a>.
      Each analysis is proxied through this server to Jev — your key is forwarded, never stored.
    </p>
    <p data-speech-insights-target="keyStatus" class="mt-1 text-xs text-zinc-500 dark:text-zinc-400"></p>
  </div>

  <p data-speech-insights-target="footerNote" class="mb-3 mt-4 text-center text-[11px] leading-relaxed text-zinc-500 dark:text-zinc-500">
    Transcription runs free in your browser (no key). Analysis is one Jev call per update
    (<code>jev-latest</code>); disabled metrics are not sent, so they cost nothing.
  </p>

  <div class="mb-8 rounded-2xl border border-black/5 bg-white/60 p-3 text-center text-[11px] leading-relaxed text-zinc-500 dark:border-white/10 dark:bg-zinc-900/60 dark:text-zinc-400">
    <strong>How your key is handled:</strong>
    your Jev key passes through this server to TypeSafe's API — it is never stored and never logged,
    but a server operator could technically see it in transit.
    Keys are revocable at
    <a href="https://console.typesafe.ai/keys" target="_blank" rel="noopener" class="underline">console.typesafe.ai/keys</a>.
    This app is
    <a href="https://github.com/tpaulshippy/syft-listening" target="_blank" rel="noopener" class="underline">open source</a>
    — read the code and run it yourself if you prefer.
  </div>
</div>
