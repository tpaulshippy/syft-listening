<% content_for :container_class, "max-w-4xl" %>
<% content_for :head do %>
  <%# Self-contained UMD build: single file, no module graph to 404 %>
  <script src="<%= asset_path("chart.umd.js") %>" defer></script>
<% end %>
<div class="w-full" data-controller="studio-tabs">
  <div class="flex items-baseline justify-between">
    <h1 class="text-xl font-bold tracking-tight">Data studio</h1>
    <span class="text-xs text-zinc-500 dark:text-zinc-400">design → input → visualize · voice + Jev, no LLM</span>
  </div>

  <div class="mt-2 rounded-2xl border border-black/5 bg-white px-4 py-3 shadow-sm dark:border-white/10 dark:bg-zinc-900" data-controller="studio-command">
    <div class="flex items-center gap-2">
      <button data-studio-command-target="micButton" data-action="click->studio-command#toggleVoice" aria-label="Voice command for every tab"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-zinc-950 text-white transition-transform hover:scale-105 active:scale-95 dark:bg-zinc-50 dark:text-zinc-950">
        <span aria-hidden="true">🎙</span>
      </button>
      <p class="text-sm text-zinc-600 dark:text-zinc-300">Command by voice — Jev routes it (“create a new field”, “edit the third row”, “visualize totals by day”).</p>
    </div>
    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400" data-studio-command-target="status" aria-live="polite">Tap 🎙 and say what to do.</p>
  </div>

  <div class="mt-2 flex gap-2" role="tablist" aria-label="Data workflow">
    <button role="tab" data-studio-tabs-target="tab" data-action="click->studio-tabs#show" data-tab="design">Design</button>
    <button role="tab" data-studio-tabs-target="tab" data-action="click->studio-tabs#show" data-tab="input">Input</button>
    <button role="tab" data-studio-tabs-target="tab" data-action="click->studio-tabs#show" data-tab="visualize">Visualize</button>
  </div>

  <!-- Design: voice interview that builds the field list. Jev classifies only. -->
  <section data-studio-tabs-target="panel" data-panel="design" role="tabpanel">
    <div class="w-full" data-controller="design">
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-300">Tap Start and speak — everything runs on voice. Say “finished” or tap Done to end.</p>
      <div class="mt-3 rounded-2xl border border-black/5 bg-white px-4 py-3 shadow-sm dark:border-white/10 dark:bg-zinc-900">
        <h2 class="text-base font-semibold" data-design-target="question">Tap Start, then speak.</h2>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400" data-design-target="stepHint"></p>
        <p class="mt-1 text-sm font-medium text-zinc-700 dark:text-zinc-200" data-design-target="choices"></p>
        <div class="mt-3 flex gap-2">
          <button data-design-target="startButton" data-action="click->design#start"
                  class="flex-1 rounded-xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white hover:bg-blue-500 disabled:opacity-40">🎙 Start</button>
          <button data-design-target="doneButton" data-action="click->design#done"
                  class="flex-1 rounded-xl border border-zinc-300 px-4 py-3 text-sm font-semibold text-zinc-700 hover:bg-zinc-100 disabled:opacity-40 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-800">Done</button>
        </div>
        <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400" data-design-target="voiceStatus">Idle.</p>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400" data-design-target="status" aria-live="polite"></p>
      </div>

      <div class="mt-2 rounded-2xl border border-black/5 bg-white px-4 py-3 shadow-sm dark:border-white/10 dark:bg-zinc-900">
        <div class="flex items-baseline justify-between">
          <h3 class="text-sm font-semibold">Fields</h3>
          <button data-action="click->design#clearAll" class="text-xs text-zinc-500 hover:text-red-600 dark:text-zinc-400">Clear all</button>
        </div>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Tap a field, then Start, to change or remove it by voice.</p>
        <div data-design-target="fieldList" class="mt-2 grid gap-2"></div>
      </div>

      <details class="mt-2 rounded-2xl border border-black/5 bg-white/60 px-4 py-2 text-xs text-zinc-600 dark:border-white/10 dark:bg-zinc-900/60 dark:text-zinc-300">
        <summary class="cursor-pointer py-1 font-medium">How this was built — Jev classifies, you name</summary>
        <div data-design-target="inspector" class="mt-2 space-y-1 font-mono"></div>
      </details>

      <div class="mb-3 mt-3 rounded-2xl border border-black/5 bg-white px-5 py-4 shadow-sm dark:border-white/10 dark:bg-zinc-900">
        <h2 class="text-[11px] font-medium tracking-[0.2em] text-zinc-400 dark:text-zinc-500">JEV API KEY</h2>
        <input data-design-target="apiKey" type="password" placeholder="ts_..." autocomplete="off" spellcheck="false"
               class="mt-2 w-full rounded-xl border border-zinc-200 bg-transparent px-3 py-2 font-mono text-base placeholder:text-zinc-400 focus:outline-none dark:border-zinc-800 dark:placeholder:text-zinc-600" />
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Same key as Visualize (stored only in this browser). A key is required — Jev answers every question.</p>
      </div>
    </div>
  </section>

  <!-- Input: voice row filling in schema order. Jev maps + validates only. -->
  <section data-studio-tabs-target="panel" data-panel="input" role="tabpanel">
    <div class="w-full" data-controller="input">
      <div class="mt-1 flex items-baseline justify-between">
        <p class="text-sm text-zinc-600 dark:text-zinc-300">Tap Start and speak — each answer is heard and saved automatically.</p>
        <p class="text-xs text-zinc-500 dark:text-zinc-400" data-input-target="progress"></p>
      </div>
      <div class="mt-3 rounded-2xl border border-black/5 bg-white px-4 py-3 shadow-sm dark:border-white/10 dark:bg-zinc-900">
        <h2 class="text-base font-semibold" data-input-target="question">Tap Start, then speak.</h2>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400" data-input-target="stepHint"></p>
        <div class="mt-3 flex gap-2">
          <button data-input-target="startButton" data-action="click->input#start"
                  class="flex-1 rounded-xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white hover:bg-blue-500 disabled:opacity-40">🎙 Start</button>
          <button data-input-target="doneButton" data-action="click->input#done"
                  class="flex-1 rounded-xl border border-zinc-300 px-4 py-3 text-sm font-semibold text-zinc-700 hover:bg-zinc-100 disabled:opacity-40 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-800">Done</button>
        </div>
        <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400" data-input-target="voiceStatus">Idle.</p>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400" data-input-target="status" aria-live="polite"></p>
      </div>

      <div class="mt-2 rounded-2xl border border-black/5 bg-white px-4 py-3 shadow-sm dark:border-white/10 dark:bg-zinc-900">
        <div class="flex items-baseline justify-between">
          <h3 class="text-sm font-semibold">Rows</h3>
          <button data-action="click->input#clearRows" class="text-xs text-zinc-500 hover:text-red-600 dark:text-zinc-400">Clear all</button>
        </div>
        <div data-input-target="rowsTable" class="mt-2"></div>
        <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400">Saved in this browser — Visualize picks them up automatically.</p>
      </div>

      <details class="mt-2 rounded-2xl border border-black/5 bg-white/60 px-4 py-2 text-xs text-zinc-600 dark:border-white/10 dark:bg-zinc-900/60 dark:text-zinc-300">
        <summary class="cursor-pointer py-1 font-medium">How this was built — Jev maps, you speak</summary>
        <div data-input-target="inspector" class="mt-2 space-y-1 font-mono"></div>
      </details>

      <div class="mb-3 mt-3 rounded-2xl border border-black/5 bg-white px-5 py-4 shadow-sm dark:border-white/10 dark:bg-zinc-900">
        <h2 class="text-[11px] font-medium tracking-[0.2em] text-zinc-400 dark:text-zinc-500">JEV API KEY</h2>
        <input data-input-target="apiKey" type="password" placeholder="ts_..." autocomplete="off" spellcheck="false"
               class="mt-2 w-full rounded-xl border border-zinc-200 bg-transparent px-3 py-2 font-mono text-base placeholder:text-zinc-400 focus:outline-none dark:border-zinc-800 dark:placeholder:text-zinc-600" />
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Same key everywhere (stored only in this browser). A key is required — Jev maps and validates every answer.</p>
      </div>
    </div>
  </section>

  <!-- Visualize: existing generalized renderer, unchanged. -->
  <section data-studio-tabs-target="panel" data-panel="visualize" role="tabpanel">
<div class="w-full" data-controller="studio">
  <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-300" data-studio-target="headline">
    Paste any dataset, then speak or type how to render it.
  </p>

  <!-- Dataset: filled automatically from the Input tab, editable here. -->
  <div class="mt-3 rounded-2xl border border-black/5 bg-white px-4 py-3 shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="font-medium">Dataset (from the Input tab — edit or paste here if needed)</span>
    </div>
    <p class="mt-1 font-mono text-[11px] text-zinc-500 dark:text-zinc-400" data-studio-target="inputShare"></p>
    <textarea data-studio-target="dataset" rows="6" spellcheck="false"
              data-action="input->studio#datasetInput"
              placeholder='[{"genre":"fiction","units":42}, …]'
              class="mt-2 max-h-64 w-full resize-y overflow-y-auto rounded-xl border border-zinc-200 bg-transparent px-3 py-2 font-mono text-base focus:outline-none dark:border-zinc-800"></textarea>
    <p class="mt-1 font-mono text-[11px] text-zinc-500 dark:text-zinc-400" data-studio-target="schemaLine">No dataset yet.</p>
  </div>

  <!-- Prompt bar -->
  <div class="mt-2 rounded-2xl border border-black/5 bg-white px-4 py-3 shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <div class="flex items-end gap-2">
      <textarea data-studio-target="prompt" rows="2" spellcheck="false"
             placeholder='"Bar chart of revenue by genre" — or tap 🎙 and say it'
             data-action="keydown->studio#promptKeydown input->studio#promptInput"
             class="max-h-64 min-w-0 flex-1 resize-y overflow-y-auto rounded-xl border border-zinc-200 bg-transparent px-3 py-2 text-base focus:outline-none dark:border-zinc-800"></textarea>
      <button data-studio-target="micButton" data-action="click->studio#toggleVoice" aria-label="Dictate your request"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-zinc-950 text-white transition-transform hover:scale-105 active:scale-95 dark:bg-zinc-50 dark:text-zinc-950">
        <span aria-hidden="true">🎙</span>
      </button>
      <button data-studio-target="askButton" data-action="click->studio#ask"
              class="shrink-0 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-500">Ask</button>
    </div>
    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-zinc-500 dark:text-zinc-400" data-studio-target="voiceStatus">Mic: tap 🎙 and speak (Chrome/Edge), or type.</span>
      <span data-studio-target="supportWarning" class="hidden rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-amber-700 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-300">No speech recognition here — type instead.</span>
    </div>
    <div class="mt-2 flex flex-wrap gap-2 text-xs">
      <button data-action="click->studio#usePrompt" data-prompt="Bar chart of revenue by genre" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">📊 Bars by genre</button>
      <button data-action="click->studio#usePrompt" data-prompt="Show the trend of units over month as a line" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">📈 Trend line</button>
      <button data-action="click->studio#usePrompt" data-prompt="Table of all incidents, biggest minutes_open first" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">🗂 Table</button>
      <button data-action="click->studio#usePrompt" data-prompt="KPI totals: how many workouts and total minutes" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">🔢 KPIs</button>
      <button data-action="click->studio#usePrompt" data-prompt="Bar chart of revenue by genre with KPI totals" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">🧩 Chart + KPIs</button>
    </div>
    <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400">Can render: table · cards · KPI · bar · line · pie · scatter · bubbles — name one, and describe filters in words (“only open incidents”). Anything Jev is unsure of repeats the question.</p>
  </div>

  <!-- Request -> UI latency line -->
  <div class="mt-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm">
    <p class="text-zinc-500 dark:text-zinc-400">Request → UI
      <span data-studio-target="latency" class="whitespace-nowrap text-2xl font-bold text-emerald-700 dark:text-emerald-400">—</span>
    </p>
    <p class="min-w-0 text-xs text-zinc-500 sm:text-right dark:text-zinc-400" data-studio-target="questionCount"></p>
  </div>
  <p class="text-xs text-zinc-500 dark:text-zinc-400" data-studio-target="status" aria-live="polite"></p>

  <!-- Rendered interface -->
  <div data-studio-target="canvas"
       class="mt-2 min-h-64 rounded-2xl border border-black/5 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <p class="text-sm text-zinc-400">Rows from the Input tab appear here — then speak or type how to render them.</p>
  </div>

  <!-- Answer inspector -->
  <details class="mt-2 rounded-2xl border border-black/5 bg-white/60 px-4 py-2 text-xs text-zinc-600 dark:border-white/10 dark:bg-zinc-900/60 dark:text-zinc-300">
    <summary class="cursor-pointer py-1 font-medium">How this was built — schema-driven questions</summary>
    <p class="mt-1 leading-relaxed">
      The server reads your dataset's column names and generates the question set
      from them: field-binding <code>choice</code> options are your actual
      columns (with sample values as evidence), plus one <code>include_*</code> flag per column. Jev answers them all in parallel and this
      generic interpreter maps the winning spec onto Chart.js or table/cards/KPI DOM. Anything
      Jev is unsure of (&lt; 0.5) repeats the question instead of rendering.
    </p>
    <div data-studio-target="inspector" class="mt-2 space-y-1 font-mono"></div>
  </details>

  <!-- API key (shared) -->
  <div class="mb-3 mt-3 rounded-2xl border border-black/5 bg-white px-5 py-4 shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <h2 class="text-[11px] font-medium tracking-[0.2em] text-zinc-400 dark:text-zinc-500">JEV API KEY</h2>
    <div class="mt-2 flex flex-col gap-2 sm:flex-row">
      <input data-studio-target="apiKey" type="password" placeholder="ts_..." autocomplete="off" spellcheck="false"
             class="w-full rounded-xl border border-zinc-200 bg-transparent px-3 py-2 font-mono text-base placeholder:text-zinc-400 focus:outline-none dark:border-zinc-800 dark:placeholder:text-zinc-600 sm:w-auto sm:flex-1" />
      <div class="flex gap-2">
        <button data-action="click->studio#toggleKeyVisibility"
                class="flex-1 rounded-full border border-zinc-300 px-3 py-2 text-xs text-zinc-600 sm:flex-none dark:border-zinc-700 dark:text-zinc-300">Show</button>
        <button data-action="click->studio#testKey" data-studio-target="testButton"
                class="flex-1 rounded-full bg-zinc-950 px-4 py-2 text-xs font-semibold text-white sm:flex-none dark:bg-zinc-50 dark:text-zinc-950">Test</button>
      </div>
    </div>
    <p data-studio-target="keyStatus" class="mt-1 text-xs text-zinc-500 dark:text-zinc-400"></p>
  </div>
</div>
  </section>
</div>
