<% content_for :container_class, "max-w-4xl" %>
<div class="w-full" data-controller="builder">
  <div class="flex items-baseline justify-between">
    <h1 class="text-xl font-bold tracking-tight">Tempo</h1>
    <span class="text-xs text-zinc-500 dark:text-zinc-400">TypeSafe workspace · voice UI builder</span>
  </div>
  <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-300" data-builder-target="headline">
    Describe the interface you want — speak it or type it.
  </p>

  <!-- Prompt bar (demo-style: text + mic + Ask) -->
  <div class="mt-3 rounded-2xl border border-black/5 bg-white px-4 py-3 shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <div class="flex items-center gap-2">
      <input data-builder-target="prompt" type="text" autocomplete="off" spellcheck="true"
             placeholder='Try: "Show open work as bubbles, coloured by owner. Flag blocked tasks."'
             data-action="keydown->builder#promptKeydown input->builder#promptInput"
             class="min-w-0 flex-1 rounded-xl border border-zinc-200 bg-transparent px-3 py-2 text-sm focus:outline-none dark:border-zinc-800" />
      <button data-builder-target="micButton" data-action="click->builder#toggleVoice" aria-label="Dictate your request"
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-zinc-950 text-white transition-transform hover:scale-105 active:scale-95 dark:bg-zinc-50 dark:text-zinc-950">
        <span aria-hidden="true">🎙</span>
      </button>
      <button data-builder-target="askButton" data-action="click->builder#ask"
              class="shrink-0 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-500">Ask</button>
    </div>
    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-zinc-500 dark:text-zinc-400" data-builder-target="voiceStatus">Mic: tap 🎙 and speak (Chrome/Edge), or type.</span>
      <span data-builder-target="supportWarning" class="hidden rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-amber-700 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-300">No speech recognition here — type instead.</span>
    </div>
    <div class="mt-2 flex flex-wrap gap-2 text-xs">
      <button data-action="click->builder#useSample" data-sample="0" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">🫧 Bubbles by owner</button>
      <button data-action="click->builder#useSample" data-sample="1" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">◐ Blocked left / ready right</button>
      <button data-action="click->builder#useSample" data-sample="2" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">☑ Cards + checkboxes</button>
      <button data-action="click->builder#useSample" data-sample="3" class="rounded-full border border-zinc-300 px-3 py-1 text-zinc-600 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">📅 Reading + gym</button>
    </div>
  </div>

  <!-- Request -> UI latency line, like the demo -->
  <div class="mt-2 flex items-baseline justify-between text-sm">
    <p class="text-zinc-500 dark:text-zinc-400">Request → UI
      <span data-builder-target="latency" class="text-2xl font-bold text-emerald-700 dark:text-emerald-400">—</span>
    </p>
    <p class="text-xs text-zinc-500 dark:text-zinc-400" data-builder-target="questionCount"></p>
  </div>
  <p class="text-xs text-zinc-500 dark:text-zinc-400" data-builder-target="status" aria-live="polite"></p>

  <!-- Rendered interface -->
  <div data-builder-target="canvas"
       class="mt-2 min-h-64 rounded-2xl border border-black/5 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <p class="text-sm text-zinc-400">Your generated interface appears here. Ask something — or tap a sample above.</p>
  </div>

  <!-- Answer inspector -->
  <details class="mt-2 rounded-2xl border border-black/5 bg-white/60 px-4 py-2 text-xs text-zinc-600 dark:border-white/10 dark:bg-zinc-900/60 dark:text-zinc-300">
    <summary class="cursor-pointer py-1 font-medium">How this was built — the parallel questions</summary>
    <p class="mt-1 leading-relaxed">
      One Jev call (<code>jev-latest</code>) sends your request plus the task/calendar dataset as
      <code>state</code>, with every UI decision enumerated up front as typed questions
      (<code>choice</code> / <code>noul</code> / <code>score</code>). Jev answers them
      <strong>all in parallel</strong> — no sequential token generation — and this page renders
      deterministically from the answers. Low-confidence answers (&lt; 0.5) fall back to the
      offline keyword parse, marked below.
    </p>
    <div data-builder-target="inspector" class="mt-2 space-y-1 font-mono"></div>
  </details>

  <!-- Dataset -->
  <details class="mt-2 rounded-2xl border border-black/5 bg-white/60 px-4 py-2 text-xs text-zinc-600 dark:border-white/10 dark:bg-zinc-900/60 dark:text-zinc-300">
    <summary class="cursor-pointer py-1 font-medium">Dataset — 14 open tasks + week calendar</summary>
    <div data-builder-target="dataset" class="mt-2"></div>
  </details>

  <!-- API key (reuses the Listening page key) -->
  <div class="mb-3 mt-3 rounded-2xl border border-black/5 bg-white px-5 py-4 shadow-sm dark:border-white/10 dark:bg-zinc-900">
    <h2 class="text-[11px] font-medium tracking-[0.2em] text-zinc-400 dark:text-zinc-500">JEV API KEY</h2>
    <div class="mt-2 flex flex-col gap-2 sm:flex-row">
      <input data-builder-target="apiKey" type="password" placeholder="ts_..." autocomplete="off" spellcheck="false"
             class="w-full rounded-xl border border-zinc-200 bg-transparent px-3 py-2 font-mono text-base placeholder:text-zinc-400 focus:outline-none dark:border-zinc-800 dark:placeholder:text-zinc-600 sm:w-auto sm:flex-1" />
      <div class="flex gap-2">
        <button data-action="click->builder#toggleKeyVisibility"
                class="flex-1 rounded-full border border-zinc-300 px-3 py-2 text-xs text-zinc-600 sm:flex-none dark:border-zinc-700 dark:text-zinc-300">Show</button>
        <button data-action="click->builder#testKey" data-builder-target="testButton"
                class="flex-1 rounded-full bg-zinc-950 px-4 py-2 text-xs font-semibold text-white sm:flex-none dark:bg-zinc-50 dark:text-zinc-950">Test</button>
      </div>
    </div>
    <p class="mt-2 text-[11px] leading-relaxed text-zinc-500 dark:text-zinc-400">
      Shared with the Listening page (<code>localStorage</code> on this device only).
      Without a key the builder still renders using its offline keyword parse — with a key,
      Jev answers the full question set in parallel.
    </p>
    <p data-builder-target="keyStatus" class="mt-1 text-xs text-zinc-500 dark:text-zinc-400"></p>
  </div>
</div>
